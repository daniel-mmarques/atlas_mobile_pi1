rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Unique @ handles. Doc id is the normalized username (no leading @).
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() &&
        resource.data.uid == request.auth.uid;
    }

    match /workouts/{workoutId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.assignedByCoachId == request.auth.uid);
      allow create: if isSignedIn() &&
        (request.resource.data.userId == request.auth.uid ||
         request.resource.data.assignedByCoachId == request.auth.uid);
      allow update, delete: if isSignedIn() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.assignedByCoachId == request.auth.uid);
    }

    match /templates/{templateId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    match /conversations/{conversationId} {
      // conversationId == 'general' allows get on a missing doc so ensureGeneral can create it.
      function canReadConversation() {
        return conversationId == 'general' ||
          resource.data.type == 'general' ||
          resource.data.type == 'community' ||
          request.auth.uid in resource.data.participantIds;
      }

      function conversationData() {
        return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      }

      function canAccessConversationById() {
        return conversationId == 'general' ||
          (exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
            (conversationData().type == 'general' ||
             conversationData().type == 'community' ||
             request.auth.uid in conversationData().participantIds));
      }

      // Missing docs deny reads that touch resource.data — allow get when the
      // caller is clearly creating a DM/coach thread addressed to them.
      function canGetMissingConversation() {
        return conversationId == 'general' ||
          ((conversationId.matches('dm_.*') || conversationId.matches('coach_.*')) &&
            conversationId.matches('.*' + request.auth.uid + '.*'));
      }

      allow get: if isSignedIn() && (
        (exists(/databases/$(database)/documents/conversations/$(conversationId))
          ? canReadConversation()
          : canGetMissingConversation())
      );
      allow list: if isSignedIn() && canReadConversation();
      allow create: if isSignedIn() &&
        (request.resource.data.type == 'general' ||
         request.auth.uid in request.resource.data.participantIds);
      allow update: if isSignedIn() &&
        (resource.data.type == 'general' ||
         request.auth.uid in resource.data.participantIds ||
         request.auth.uid in request.resource.data.participantIds);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() && canAccessConversationById();
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          canAccessConversationById();
        allow update, delete: if isSignedIn() && canAccessConversationById();
      }
    }

    match /coach_links/{linkId} {
      allow read: if isSignedIn() &&
        (resource.data.coachId == request.auth.uid ||
         resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        (resource.data.coachId == request.auth.uid ||
         resource.data.studentId == request.auth.uid);
    }

    match /link_invitations/{token} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.creatorId == request.auth.uid;
      allow update: if isSignedIn();
    }
  }
}
